{
  "name": "unstuck",
  "private": true,
  "packageManager": "pnpm@12.16.1",
  "engines": { "node": ">=22" },
  "scripts": {
    "dev": "pnpm --filter @unstuck/web dev",
    "build": "pnpm -r build",
    "test": "vitest run",
    "typecheck": "pnpm -r typecheck",
    "db:up": "docker compose up -d db",
    "db:push": "pnpm --filter @unstuck/db push"
  },
  "devDependencies": {
    "typescript": "^5.9.0",
    "vitest": "^3.2.0",
    "@types/node": "^22"
  }
}
