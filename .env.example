DATABASE_URL=postgres://unstuck:unstuck@localhost:5440/unstuck
# NEAR AI Cloud key from https://cloud.near.ai (set a spend limit)
NEAR_AI_API_KEY=
# Optional. Raises GitHub API rate limits for public thread reads.
GITHUB_TOKEN=
# Public origin, no trailing slash. Canonical URLs, Open Graph images, the sitemap and llms.txt use it.
# Search engines are only let in on an https origin; anything else is served with noindex.
SITE_URL=http://localhost:3000
# Seals Agent Market OAuth tokens at rest (AES-256-GCM). 32 random bytes in base64: `openssl rand -base64 32`.
# Without it, Agent Market sign-in is refused. Changing it makes stored sign-ins unreadable, so owners sign out and in again.
MARKET_TOKEN_KEY=
